# Public hostname used by Caddy for automatic HTTPS.
DOMAIN=example.com

# Gemini API for research chat. Case details and document excerpts are sent to Google with each question;
# use a paid (billing-enabled) key so prompts are not used for model training. Research reports "unavailable" without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

PUBLIC_APP_URL=https://example.com

# Monthly final prices (including taxes) shown on the pricing page and checked when you record a payment.
# Set the currency and amounts to exactly what your Clip links charge, e.g. MXN and 199.00.
PRICE_CURRENCY=EUR
PRICE_PERSONAL=9.90
PRICE_BUSINESS=29.90
PRICE_FIRM=49.90

# Reusable Clip payment links (https://...), one per plan, each charging one month at the price above.
# A plan cannot be paid for until its link is set. Payments are confirmed by an administrator in the app.
CLIP_LINK_PERSONAL=
CLIP_LINK_BUSINESS=
CLIP_LINK_FIRM=

# Impressum and privacy notice. Shown publicly; name, address and email are required before go-live.
# Separate address lines with semicolons, e.g. "Musterstraße 1; 10115 Berlin; Deutschland".
OPERATOR_NAME=
OPERATOR_LEGAL_FORM=
OPERATOR_REPRESENTATIVE=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
# Commercial register and number, if registered.
OPERATOR_REGISTER=
# VAT ID (USt-IdNr.) or RFC.
OPERATOR_TAX_ID=
# Person responsible for content (§ 18 Abs. 2 MStV); defaults to the representative.
OPERATOR_CONTENT_RESPONSIBLE=
# Server hosting company and country, and the email delivery provider, named in the privacy notice.
OPERATOR_HOSTING=
OPERATOR_MAIL_PROVIDER=

# Outgoing email (password reset, address confirmation, sending drafts). Nothing is sent until SMTP_HOST and SMTP_FROM are set.
# SMTP_SECURITY: starttls (default, port 587), ssl (port 465) or none.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Schimmelpilz <noreply@example.com>
SMTP_SECURITY=starttls
# Local testing only: write messages as .eml files into this folder instead of sending them.
MAIL_OUTBOX_DIR=

# Administrators must use two-factor login for operator functions. Set to false only for local development.
ADMIN_MFA_REQUIRED=true

# Daily encrypted backup (backup service). Copy this folder AND the backup key volume to another machine.
BACKUP_PATH=./backups/docker
BACKUP_HOUR_UTC=2
# 0 keeps every backup. A positive value deletes archives older than this many days (the newest is always kept).
BACKUP_KEEP_DAYS=0
