<?xml version="1.0" encoding="utf-8"?>
<!-- Debug/test builds only: plain HTTP is allowed so the app can reach a test server in the home network
     (e.g. http://192.168.1.20:8001). Release builds stay HTTPS-only (src/main/res/xml). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
